{
  "name": "workspace-care",
  "version": "0.1.1",
  "description": "Workspace Care",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "it.workspacecare.app",
    "productName": "Workspace Care",
    "directories": {
      "output": "out"
    },
    "files": [
      "main.js",
      "preload.js",
      "icon.png"
    ],
    "extraResources": [
      {
        "from": "../backend/pocketbase.exe",
        "to": "backend/pocketbase.exe"
      },
      {
        "from": "../backend/pb_migrations",
        "to": "backend/pb_migrations"
      },
      {
        "from": "../backend/pb_hooks",
        "to": "backend/pb_hooks"
      },
      {
        "from": "../frontend/dist/frontend/browser",
        "to": "frontend"
      }
    ],
    "win": {
      "icon": "icon.png"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "AndreaPaper",
        "repo": "workspace-care"
      }
    ],
    "nsis": {
      "artifactName": "Workspace-Care-Setup-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "^45.3.4",
    "electron-builder": "^26.18.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
